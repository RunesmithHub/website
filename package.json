{
  "name": "runesmith-hub-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-data.ts && next dev",
    "build": "node scripts/prepare-data.ts && next build && node scripts/finalize-output.ts",
    "serve": "node scripts/serve.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fixture": "node tests/fixtures/generate.ts",
    "test": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
